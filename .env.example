# Ugavi Environment Template
# Copy to .env and customize before deploying
# cp .env.example .env

# Database
MARIADB_ROOT_PASSWORD=change-me-in-production

# Admin credentials
ADMIN_PASSWORD=change-me

# Site name (must match hosts file entry for local dev)
SITE_NAME=ugavi.localhost

# Every production tenant requires a unique Compose project and environment file.
COMPOSE_PROJECT_NAME=ugavi-local

# Ports
NGINX_LISTEN_PORT=8080
DB_PORT=3306
SOCKETIO_PORT=9000

# Service hosts
DB_HOST=mariadb
REDIS_CACHE=redis:6379
REDIS_QUEUE=redis:6379

# Image
UGAVI_IMAGE=ugavi
UGAVI_TAG=16

# Gunicorn
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Security
# Keep disabled for deterministic local demo logins. Production must set this to 1
# and enrol privileged users before go-live.
UGAVI_ENFORCE_2FA=0
# M-Pesa (Safaricom Daraja B2C) supplier disbursement.
# Leave blank for the demo: Payment Entries are marked "Not Transmitted" and no
# disbursement is fabricated. Set every value to enable real transmission.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SECURITY_CREDENTIAL=
MPESA_INITIATOR_NAME=
MPESA_SHORTCODE=
