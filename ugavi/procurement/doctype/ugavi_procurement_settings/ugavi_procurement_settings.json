{
    "custom": 0,
    "doctype": "DocType",
    "fields": [
        {
            "fieldname": "section_thresholds",
            "fieldtype": "Section Break",
            "label": "Procurement Method Thresholds"
        },
        {
            "default": "Today",
            "fieldname": "effective_from",
            "fieldtype": "Date",
            "label": "Thresholds Effective From",
            "reqd": 1
        },
        {
            "default": "200000",
            "description": "Values below this use Direct/RFQ method",
            "fieldname": "direct_threshold",
            "fieldtype": "Currency",
            "in_list_view": 1,
            "label": "Direct Purchase (RFQ) Threshold",
            "reqd": 1
        },
        {
            "default": "500000",
            "description": "Values from direct_threshold up to this use Restricted Tender",
            "fieldname": "restricted_threshold",
            "fieldtype": "Currency",
            "in_list_view": 1,
            "label": "Restricted Tender Threshold",
            "reqd": 1
        },
        {
            "default": "500000",
            "description": "Values at or above this use Open Tender",
            "fieldname": "open_threshold",
            "fieldtype": "Currency",
            "in_list_view": 1,
            "label": "Open Tender Minimum",
            "reqd": 1
        },
        {
            "fieldname": "section_governance",
            "fieldtype": "Section Break",
            "label": "Governance & Controls"
        },
        {
            "default": "1",
            "fieldname": "enforce_donor_rules",
            "fieldtype": "Check",
            "label": "Enforce Donor-Specific Rules"
        },
        {
            "default": "1",
            "description": "Any manual override of procurement method requires an approved Waiver",
            "fieldname": "require_waiver_for_override",
            "fieldtype": "Check",
            "label": "Require Waiver for Method Override"
        },
        {
            "default": "1",
