            "fieldname": "complaint_response_days",
            "fieldtype": "Int",
            "label": "Complaint Response Target (days)",
            "reqd": 1
        },
        {
            "fieldname": "section_defaults",
            "fieldtype": "Section Break",
            "label": "Defaults"
