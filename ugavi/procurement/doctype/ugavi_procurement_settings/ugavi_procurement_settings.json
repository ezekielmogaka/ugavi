{
 "name": "Ugavi Procurement Settings",
 "module": "Procurement",
 "issingle": 1,
 "istable": 0,
 "track_changes": 0,
 "custom": 0,
 "fields": [
  {
   "fieldname": "section_thresholds",
   "fieldtype": "Section Break",
   "label": "Procurement Method Thresholds"
  },
  {
   "fieldname": "direct_threshold",
   "fieldtype": "Currency",
   "label": "Direct Purchase (RFQ) Threshold",
   "description": "Values below this use Direct/RFQ method",
   "default": "200000",
   "in_list_view": 1,
   "reqd": 1
  },
  {
   "fieldname": "restricted_threshold",
   "fieldtype": "Currency",
   "label": "Restricted Tender Threshold",
   "description": "Values from direct_threshold up to this use Restricted Tender",
   "default": "500000",
   "in_list_view": 1,
   "reqd": 1
  },
  {
   "fieldname": "open_threshold",
   "fieldtype": "Currency",
   "label": "Open Tender Minimum",
   "description": "Values at or above this use Open Tender",
   "default": "500000",
   "in_list_view": 1,
   "reqd": 1
  },
  {
   "fieldname": "section_governance",
   "fieldtype": "Section Break",
   "label": "Governance & Controls"
  },
  {
   "fieldname": "enforce_donor_rules",
   "fieldtype": "Check",
   "label": "Enforce Donor-Specific Rules",
   "default": "1"
  },
  {
   "fieldname": "require_waiver_for_override",
   "fieldtype": "Check",
   "label": "Require Waiver for Method Override",
   "description": "Any manual override of procurement method requires an approved Waiver",
   "default": "1"
  },
  {
   "fieldname": "sealed_bid_enabled",
   "fieldtype": "Check",
   "label": "Enable Sealed Bids",
   "description": "Encrypt bids; require 3-officer opening for tenders",
   "default": "1"
  },
  {
   "fieldname": "otp_expiry_minutes",
   "fieldtype": "Int",
   "label": "OTP Expiry (minutes)",
   "default": "5",
   "reqd": 1
  },
  {
   "fieldname": "max_otp_attempts",
   "fieldtype": "Int",
   "label": "Max OTP Attempts",
   "default": "3",
   "reqd": 1
  },
  {
   "fieldname": "section_defaults",
   "fieldtype": "Section Break",
   "label": "Defaults"
  },
  {
   "fieldname": "default_currency",
   "fieldtype": "Link",
   "label": "Default Currency",
   "options": "Currency",
   "default": "KES"
  },
  {
   "fieldname": "default_approver_role",
   "fieldtype": "Link",
   "label": "Default Approver Role",
   "options": "Role",
   "description": "Fallback when no DoA rule matches"
  },
  {
   "fieldname": "default_company",
   "fieldtype": "Link",
   "label": "Default Company",
   "options": "Company"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 0
  }
 ]
}