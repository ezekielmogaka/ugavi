            "fieldtype": "Int",
            "label": "OTP Expiry (minutes)",
            "reqd": 1
        },
        {
            "default": "3",
            "fieldname": "max_otp_attempts",
            "fieldtype": "Int",
            "label": "Max OTP Attempts",
            "reqd": 1
        },
        {
            "default": "14",
