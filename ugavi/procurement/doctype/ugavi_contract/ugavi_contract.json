{
    "custom": 0,
    "doctype": "DocType",
    "fields": [
        {
            "fieldname": "tender",
            "fieldtype": "Link",
            "label": "Tender",
            "options": "Tender"
        },
        {
            "fieldname": "purchase_order",
            "fieldtype": "Link",
            "label": "Purchase Order",
            "options": "Purchase Order",
            "unique": 1
        },
        {
            "fieldname": "supplier",
            "fieldtype": "Link",
            "label": "Supplier",
            "options": "Supplier",
            "reqd": 1
        },
        {
            "default": "Draft",
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "Draft\nActive\nCompleted\nTerminated\nExpired",
            "reqd": 1
        },
        {
            "fieldname": "start_date",
            "fieldtype": "Date",
            "label": "Start Date",
            "reqd": 1
        },
        {
            "fieldname": "end_date",
            "fieldtype": "Date",
            "label": "End Date"
        },
        {
            "fieldname": "contract_value",
            "fieldtype": "Currency",
            "label": "Contract Value"
        },
        {
            "fieldname": "donor",
            "fieldtype": "Link",
            "label": "Donor",
            "options": "Donor Profile"
        },
        {
            "fieldname": "retention_percentage",
            "fieldtype": "Percent",
            "label": "Retention %"
        },
        {
            "fieldname": "performance_bond_required",
            "fieldtype": "Check",
            "label": "Performance Bond Required"
        },
        {
            "depends_on": "eval:doc.performance_bond_required",
            "fieldname": "bond_amount",
            "fieldtype": "Currency",
            "label": "Bond Amount"
        },
        {
            "default": "30",
            "fieldname": "expiry_alert_days",
            "fieldtype": "Int",
            "label": "Expiry Alert (Days)"
        },
        {
            "fieldname": "documents",
            "fieldtype": "Table",
            "label": "Documents",
            "options": "Contract Document"
        },
        {
            "fieldname": "completion_date",
            "fieldtype": "Date",
            "label": "Completion Date",
            "read_only": 1
        },
        {
            "fieldname": "termination_reason",
            "fieldtype": "Small Text",
            "label": "Termination Reason",
            "depends_on": "eval:doc.status == 'Terminated'"
        },
        {
            "fieldname": "milestones",
            "fieldtype": "Table",
            "label": "Milestones",
            "options": "Contract Milestone"
        }
    ],
    "istable": 0,
    "module": "Procurement",
    "name": "Ugavi Contract",
    "permissions": [
        {
            "create": 1,
            "delete": 0,
            "read": 1,
            "role": "System Manager",
            "write": 1
        }
    ],
    "track_changes": 1
}
