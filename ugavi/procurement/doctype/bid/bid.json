{
    "autoname": "BID-.YYYY.-.####",
    "custom": 0,
    "doctype": "DocType",
    "fields": [
        {
            "fieldname": "tender",
            "fieldtype": "Link",
            "in_list_view": 1,
            "in_standard_filter": 1,
            "label": "Tender",
            "options": "Tender",
            "reqd": 1
        },
        {
            "fieldname": "supplier",
            "fieldtype": "Link",
            "in_list_view": 1,
            "label": "Supplier",
            "options": "Supplier",
            "reqd": 1
        },
        {
            "default": "Draft",
            "fieldname": "status",
            "fieldtype": "Select",
            "in_list_view": 1,
            "label": "Status",
            "options": "Draft\nSubmitted\nLate\nWithdrawn\nOpened\nEvaluated\nAccepted\nRejected",
            "reqd": 1
        },
        {
            "fieldname": "submission_date",
            "fieldtype": "Datetime",
            "in_list_view": 1,
            "label": "Submission Date",
            "read_only": 1
        },
        {
            "fieldname": "technical_proposal",
            "fieldtype": "Attach",
            "label": "Technical Proposal"
        },
        {
            "fieldname": "submission_receipt",
            "fieldtype": "Data",
            "label": "Submission Receipt",
            "read_only": 1,
            "unique": 1
        },
        {
            "depends_on": "eval:doc.status == 'Submitted'",
            "fieldname": "section_encrypted",
            "fieldtype": "Section Break",
            "label": "Encrypted Bid Content"
        },
        {
            "description": "RSA-encrypted AES key",
            "fieldname": "encrypted_key",
            "fieldtype": "Long Text",
            "label": "Encrypted AES Key",
            "read_only": 1
        },
        {
            "fieldname": "nonce",
            "fieldtype": "Data",
            "label": "Nonce",
            "read_only": 1
        },
        {
            "fieldname": "encrypted_content",
            "fieldtype": "Long Text",
            "label": "Encrypted Bid Content",
            "read_only": 1
        },
        {
            "depends_on": "eval:doc.status == 'Opened' || doc.status == 'Evaluated'",
            "fieldname": "section_evaluation",
            "fieldtype": "Section Break",
            "label": "Evaluation"
        },
        {
            "fieldname": "bidder_name",
            "fieldtype": "Data",
            "label": "Bidder Name",
            "read_only": 1
        },
        {
            "fieldname": "bid_amount",
            "fieldtype": "Currency",
            "label": "Bid Amount",
            "read_only": 1
        },
        {
            "default": "KES",
            "fieldname": "bid_currency",
            "fieldtype": "Link",
            "label": "Bid Currency",
            "options": "Currency",
            "read_only": 1
        },
        {
            "fieldname": "delivery_days",
            "fieldtype": "Int",
            "label": "Delivery (days)",
            "read_only": 1
        },
        {
            "depends_on": "eval:doc.status == 'Evaluated'",
            "fieldname": "technical_score",
            "fieldtype": "Float",
            "label": "Technical Score"
        },
        {
            "depends_on": "eval:doc.status == 'Evaluated'",
            "fieldname": "financial_score",
            "fieldtype": "Float",
            "label": "Financial Score"
        },
        {
            "depends_on": "eval:doc.status == 'Evaluated'",
            "fieldname": "total_score",
            "fieldtype": "Float",
            "label": "Total Score",
            "read_only": 1
        },
        {
            "depends_on": "eval:doc.status == 'Evaluated'",
            "fieldname": "evaluation_notes",
            "fieldtype": "Small Text",
            "label": "Evaluation Notes"
        }
    ],
    "istable": 0,
    "module": "Procurement",
    "name": "Bid",
    "naming_rule": "By script",
    "permissions": [
        {
            "create": 1,
            "delete": 0,
            "read": 1,
            "role": "System Manager",
            "write": 1
        },
        {
            "create": 1,
            "delete": 0,
            "read": 1,
            "role": "Procurement Officer",
            "write": 1
        },
        {
            "create": 1,
            "delete": 0,
            "read": 1,
            "role": "Supplier",
            "write": 1
        }
    ],
    "track_changes": 1,
    "track_seen": 1,
    "track_views": 1
}
