    },
    {
      "fieldname": "from_location",
      "fieldtype": "Link",
      "label": "From Location",
      "options": "Warehouse",
      "read_only": 1
    },
    {
      "fieldname": "to_location",
      "fieldtype": "Link",
      "label": "To Location",
      "options": "Warehouse",
      "reqd": 1
    },
    {
      "fieldname": "from_custodian",
      "fieldtype": "Link",
      "label": "From Custodian",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "to_custodian",
      "fieldtype": "Link",
      "label": "To Custodian",
      "options": "User"
    },
    {
      "fieldname": "from_condition",
      "fieldtype": "Select",
      "label": "Condition Before Movement",
      "options": "New\nGood\nFair\nPoor\nDisposed",
      "read_only": 1
    },
    {
      "fieldname": "to_condition",
